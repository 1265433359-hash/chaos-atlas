    {
      "rule": "edge has statically-confirmed explicit_timeout AND loss_bounded=true -> protected for delay AND loss",
      "rule_id": "CLS-001"
    },
    {
      "rule": "edge has statically-confirmed explicit_timeout with loss_bounded=false -> protected for delay (bounded to the timeout); unprotected for loss (loss not statically bounded)",
      "rule_id": "CLS-002"
    },
    {
      "rule": "edge has statically-confirmed absence of a bounded-timeout/deadline defense (no_timeout or no per-call deadline) -> unprotected for delay and loss",
      "rule_id": "CLS-003"
    },
    {
      "rule": "kill candidate -> protected only if a static availability oracle confirms a defense (replicas>=2 or PDB or HPA); unprotected only if single-replica without PDB is confirmed; otherwise unknown",
      "rule_id": "CLS-004"
    },
    {
      "rule": "no static evidence sufficient to classify the family-specific defense -> unknown",
      "rule_id": "CLS-005"
    }
  ],
