{
  "schema_version": "chaosatlas-project-profile-v1",
  "project_id": "immich",
  "project_commit": "5cf305a3a239e0619f756a5cdcb380e83e90d6a04f2065adb5e7f1afee5c2629",
  "revision_kind": "digest",
  "deployment_snapshot": {
    "chart": "immich-0.12.0",
    "app_version": "v2.6.3",
    "primary_image": "ghcr.io/immich-app/immich-server:v2.6.3"
  },
  "namespace_policy": {
    "allowed_namespaces": ["chaosatlas-immich"],
    "isolation_required": true,
    "cluster_profile": "chaosatlas-apps"
  },
  "isolation": {
    "l1": {
      "mode": "adopted-test-replica",
      "dedicated_test_replica": true,
      "namespace": "chaosatlas-immich"
    },
    "l2": {
      "mode": "ephemeral-target",
      "ready_timeout_s": 420,
      "cleanup_timeout_s": 180,
      "resource_budget": {"cpu": "4", "memory": "5Gi", "pods": 8},
      "blueprint_ref": "isolation/l2-blueprint.json"
    },
    "fault_routes": {
      "secret_rotation": {"level": "L2", "backend": "kubernetes_api"},
      "image_pull_failure": {"level": "L2", "backend": "kubernetes_api"},
      "pod_unschedulable": {"level": "L2", "backend": "kubernetes_api"}
    },
    "synthetic_data_only": true
  },
  "source": {
    "manifest_roots": ["projects/chaosatlas-apps/k8s"],
    "source_roots": ["projects/chaosatlas-apps/k8s"]
  },
  "business_oracles": [
    {
      "id": "immich-server-ping",
      "kind": "http",
      "service": "immich-server",
      "remote_port": 2283,
      "entrypoint": "/api/server/ping",
      "request_headers": {"Host": "immich.local"},
      "expected_status": 200,
      "expected_body": "pong",
      "success_contract": "http_200_body_contains_pong",
      "timeout_s": 10,
      "count": 3,
      "baseline_retry_window_s": 30,
      "observation_window_s": 60,
      "probe_retry_interval_s": 2
    }
  ],
  "observability": {
    "logs": {"provider": "kubectl", "required": true},
    "events": {"provider": "kubectl", "required": true},
    "traces": {"provider": "none", "required": false}
  },
  "recovery": {
    "deadline_s": 180,
    "require_business_probe": true,
    "require_cleanup": true
  },
  "cleanup": {"owner": "chaosatlas", "must_be_empty": true},
  "sensitive_data_policy": {
    "redact_fields": ["password", "secret", "token", "authorization", "cookie"],
    "allow_redacted_placeholders": true
  },
  "runtime_contract": {
    "backend": "kubernetes_chaos_mesh",
    "kube_context": "chaosatlas-apps",
    "supported_fault_families": ["pod_kill"]
  },
  "fault_support": {
    "pod_kill": {
      "status": "supported",
      "reason": "generic Kubernetes lifecycle verified on 2026-09-05 with baseline, confirmed injection, degraded service observation, replacement recovery, and zero-residue cleanup; one run is not a stable application finding"
    }
  },
  "fault_defaults": {
    "secret_rotation": {"secret_name": "immich-db", "key": "password"},
    "image_pull_failure": {"image": "chaosatlas.invalid/not-found:test"},
    "pod_unschedulable": {"node_selector_key": "chaosatlas.invalid/never", "node_selector_value": "true"}
  }
}
