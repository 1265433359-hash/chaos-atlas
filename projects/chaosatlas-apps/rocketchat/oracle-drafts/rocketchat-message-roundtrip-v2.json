{
  "allowed_requests": [
    {
      "id": "create-room",
      "method": "POST",
      "path": "/api/v1/channels.create"
    },
    {
      "id": "room-info",
      "method": "GET",
      "path": "/api/v1/rooms.info"
    },
    {
      "id": "post-message",
      "method": "POST",
      "path": "/api/v1/chat.postMessage"
    },
    {
      "id": "read-messages",
      "method": "GET",
      "path": "/api/v1/channels.messages"
    },
    {
      "id": "delete-room",
      "method": "POST",
      "path": "/api/v1/channels.delete"
    }
  ],
  "approval": {
    "record": null,
    "required": true
  },
  "assertions": [
    {
      "expected_from": "room_id",
      "id": "room-owner",
      "operator": "json_path_equals",
      "path": "$.messages[0].rid",
      "step_id": "poll-messages"
    },
    {
      "expected": "ChaosAtlas synthetic {run_id}",
      "id": "message-body",
      "operator": "json_path_equals",
      "path": "$.messages[0].msg",
      "step_id": "poll-messages"
    },
    {
      "assertion_ref": "message-body",
      "id": "async-visible",
      "operator": "eventually",
      "step_id": "poll-messages"
    }
  ],
  "cleanup": {
    "on_every_exit": true,
    "steps": [
      {
        "acceptable_statuses": [
          200
        ],
        "id": "delete-owned-room",
        "json_body": {
          "roomId": "{room_id}"
        },
        "request_id": "delete-room",
        "required_variables": [
          "room_id"
        ]
      }
    ],
    "strategy": "exact_owned_ids"
  },
  "contract_sha256": "c7f5f39c37e75d5918f502781107c6ea221eee2459df4f1a4238056c7e76e5f1",
  "credential_refs": [
    {
      "id": "rocketchat-test-user",
      "source": "runtime_secret_ref"
    }
  ],
  "evidence_sources": [
    "image:rocket.chat:8.6.1",
    "api:channels.create,chat.postMessage,channels.messages,channels.delete"
  ],
  "oracle_id": "rocketchat-message-roundtrip-v2",
  "ownership": {
    "delete_scope": "returned_or_exactly_queried_ids",
    "marker_field": "chaosatlas_run_id",
    "synthetic_only": true
  },
  "probe_steps": [
    "poll-messages"
  ],
  "project_id": "rocketchat",
  "project_revision": "5f9f0b3332fa175da829a92dca7f86e5d6223b1581d2c4372838133e929b8bf4",
  "schema_version": "chaosatlas-transaction-oracle-v2",
  "status": "validated",
  "steps": [
    {
      "capture": {
        "room_id": "$.channel._id"
      },
      "id": "create-owned-room",
      "json_body": {
        "name": "ca-{run_id}"
      },
      "on_response_loss": {
        "capture": {
          "room_id": "$.room._id"
        },
        "query": {
          "roomName": "ca-{run_id}"
        },
        "request_id": "room-info",
        "strategy": "exact_lookup"
      },
      "request_id": "create-room"
    },
    {
      "capture": {
        "message_id": "$.message._id"
      },
      "id": "post-owned-message",
      "json_body": {
        "roomId": "{room_id}",
        "text": "ChaosAtlas synthetic {run_id}"
      },
      "on_response_loss": {
        "capture": {
          "message_id": "$.messages[0]._id"
        },
        "query": {
          "count": 1,
          "roomId": "{room_id}"
        },
        "request_id": "read-messages",
        "strategy": "exact_lookup"
      },
      "request_id": "post-message"
    },
    {
      "id": "poll-messages",
      "query": {
        "count": 20,
        "roomId": "{room_id}"
      },
      "request_id": "read-messages"
    }
  ],
  "timeouts": {
    "eventual_s": 30,
    "poll_interval_s": 2,
    "request_s": 10
  }
}
