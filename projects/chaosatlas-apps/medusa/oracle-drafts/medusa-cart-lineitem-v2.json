{
  "allowed_requests": [
    {
      "id": "create-cart",
      "method": "POST",
      "path": "/store/carts"
    },
    {
      "id": "add-line",
      "method": "POST",
      "path": "/store/carts/{cart_id}/line-items"
    },
    {
      "id": "read-cart",
      "method": "GET",
      "path": "/store/carts/{cart_id}"
    },
    {
      "id": "delete-line",
      "method": "DELETE",
      "path": "/store/carts/{cart_id}/line-items/{line_id}"
    }
  ],
  "approval": {
    "record": null,
    "required": true
  },
  "assertions": [
    {
      "expected": 1,
      "id": "quantity",
      "operator": "json_path_equals",
      "path": "$.cart.items[0].quantity",
      "step_id": "read-cart"
    },
    {
      "expected_from": "fixture_currency",
      "id": "currency",
      "operator": "json_path_equals",
      "path": "$.cart.currency_code",
      "step_id": "read-cart"
    },
    {
      "expected_from": "fixture_unit_price",
      "id": "unit-price",
      "operator": "json_path_equals",
      "path": "$.cart.items[0].unit_price",
      "step_id": "read-cart"
    }
  ],
  "cleanup": {
    "environment_release_required": true,
    "on_every_exit": true,
    "reason": "No approved Store API cart-delete operation; delete the exact line item, then destroy the disposable database environment.",
    "steps": [
      {
        "acceptable_statuses": [
          200
        ],
        "id": "delete-owned-line",
        "path_variables": {
          "cart_id": "{cart_id}",
          "line_id": "{line_id}"
        },
        "request_id": "delete-line",
        "required_variables": [
          "cart_id",
          "line_id"
        ]
      }
    ],
    "strategy": "disposable_environment"
  },
  "contract_sha256": "d88dcdbd350affb5750c7b0bea7dae12dd347052c9145a99787531e616b0dd34",
  "credential_refs": [
    {
      "id": "medusa-publishable-api-key",
      "source": "runtime_secret_ref"
    }
  ],
  "evidence_sources": [
    "image:medusa-backend:2.20.1",
    "source:apps/backend/src"
  ],
  "oracle_id": "medusa-cart-lineitem-v2",
  "ownership": {
    "delete_scope": "returned_or_exactly_queried_ids",
    "marker_field": "chaosatlas_run_id",
    "synthetic_only": true
  },
  "probe_steps": [
    "read-cart"
  ],
  "project_id": "medusa",
  "project_revision": "52c3aa27333530c946e3b2c1b025c988c432283257b053cb61269c5ab2da6334",
  "schema_version": "chaosatlas-transaction-oracle-v2",
  "status": "validated",
  "steps": [
    {
      "capture": {
        "cart_id": "$.cart.id"
      },
      "id": "create-cart",
      "json_body": {
        "region_id": "{synthetic_region_id}"
      },
      "on_response_loss": {
        "strategy": "disposable_environment"
      },
      "request_id": "create-cart"
    },
    {
      "capture": {
        "line_id": "$.cart.items[0].id"
      },
      "fixture_refs": [
        "synthetic_region_id",
        "synthetic_variant_id"
      ],
      "id": "add-synthetic-variant",
      "json_body": {
        "quantity": 1,
        "variant_id": "{synthetic_variant_id}"
      },
      "on_response_loss": {
        "capture": {
          "line_id": "$.cart.items[0].id"
        },
        "path_variables": {
          "cart_id": "{cart_id}"
        },
        "request_id": "read-cart",
        "strategy": "exact_lookup"
      },
      "path_variables": {
        "cart_id": "{cart_id}"
      },
      "request_id": "add-line"
    },
    {
      "id": "read-cart",
      "path_variables": {
        "cart_id": "{cart_id}"
      },
      "request_id": "read-cart"
    }
  ],
  "timeouts": {
    "eventual_s": 30,
    "poll_interval_s": 2,
    "request_s": 10
  }
}
